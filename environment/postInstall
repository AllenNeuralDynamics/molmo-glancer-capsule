#!/usr/bin/env bash
# postInstall — runs after Docker image build.
# Runs after Docker image build — installs deps not available in Code Ocean UI.
set -e

pip3 install --no-cache-dir torchvision --upgrade --extra-index-url https://download.pytorch.org/whl/cu124

# Install Chromium for Playwright (system deps already in apt-get)
playwright install chromium